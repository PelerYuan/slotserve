    "etc/profile.d/slotserve.sh": {
      "mode": "0o644",
      "text": "# Added by SlotServe\n[ -d /workspace ] && [ \"$PWD\" = \"$HOME\" ] && cd /workspace\n"
    },
    "opt/slotserve/dropbearmulti": {
      "mode": "0o755",
      "text": "ELF golden dropbear"
    },
    "opt/slotserve/lib.sh": {
      "mode": "0o644",
      "text": "# SlotServe helpers\nset_hash() {\n  # $1 = account, $2 = SHA-512-crypt hash, \"*\" (no password) or \"!\" (locked)\n  if command -v chpasswd >/dev/null 2>&1 && printf '%s:%s\\n' \"$1\" \"$2\" | chpasswd -e >/dev/null 2>&1; then\n    return 0\n  fi\n  if command -v usermod >/dev/null 2>&1 && usermod -p \"$2\" \"$1\" >/dev/null 2>&1; then\n    return 0\n  fi\n  for f in /etc/shadow /etc/passwd; do\n    if [ -f \"$f\" ] && grep -q \"^$1:\" \"$f\"; then\n      awk -F: -v OFS=: -v u=\"$1\" -v h=\"$2\" '$1 == u { $2 = h } { print }' \"$f\" > \"$f.slotserve\" \\\n        && cat \"$f.slotserve\" > \"$f\"\n      rm -f \"$f.slotserve\"\n      return 0\n    fi\n  done\n  echo \"slotserve: could not set the password of $1\" >&2\n  return 1\n}\n"
    },
    "opt/slotserve/root.hash": {
      "mode": "0o600",
      "text": "$6$goldensalt$alicehash"
    },
    "opt/slotserve/ssh.sh": {
      "mode": "0o755",
      "text": "#!/bin/sh\n# Started by SlotServe: sets up the logins, then runs the SSH server (Dropbear).\nS=/opt/slotserve\n. $S/lib.sh\nsetup() {\n  if [ -f $S/root.hash ]; then\n    set_hash root \"$(cat $S/root.hash)\" || true\n    rm -f $S/root.hash\n  fi\n  return 0\n}\ncase \"$1\" in\n  --setup) setup; exit $? ;;\n  --run) ;;\n  *) setup || exit 1 ;;\nesac\nexec $S/dropbearmulti dropbear -F -e  -K 60 -T 3 -p 22 \\\n  -r $S/ssh_host_key -D $S/ssh -P /tmp/.slotserve-dropbear.pid\n"
    },
    "opt/slotserve/ssh/authorized_keys": {
      "mode": "0o600",
      "text": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGoldenAliceKeyGoldenAliceKeyGoldenAlice alice@laptop\nssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQGoldenAliceRsa alice@desktop\n"
    },
    "opt/slotserve/ssh_host_key": {
      "mode": "0o600",
      "text": "golden host key"
    },
    "opt/slotserve/start.sh": {
      "mode": "0o755",
      "text": "#!/bin/sh\n# Started by SlotServe: an SSH server (dropbear) next to the environment's own main process.\n/bin/sh /opt/slotserve/ssh.sh --setup || exit 1\n/bin/sh /opt/slotserve/ssh.sh --run &\ncd /workspace 2>/dev/null || true\nif [ \"$#\" -gt 0 ]; then exec \"$@\"; fi\nwhile :; do sleep 3600; done\n"
    }
