# Copy to `.env` and edit. Lines starting with # are comments.

# ---------------------------------------------------------------------------
# Host paths (used by docker compose)
# ---------------------------------------------------------------------------

# Directory containing your compiled `llama-server` binary (and libggml*.so / libllama.so).
# For a CMake build this is usually <llama.cpp>/build/bin
LLAMA_CPP_DIR=/opt/llama.cpp/build/bin

# Directory holding .gguf models. Downloads from the web UI are saved here too.
MODELS_DIR=/srv/models

# SQLite database and logs.
DATA_DIR=./data

# Port for the web UI and the OpenAI-compatible API.
PORT=8000

# CUDA runtime image; keep the major version equal to the one llama.cpp was built with.
# CUDA_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04

# ---------------------------------------------------------------------------
# SlotServe
# ---------------------------------------------------------------------------

# Required to sign up. Share it only with your team.
SLOTSERVE_INVITE_CODE=change-me
# Set to false to stop self sign-up (admins can still create accounts)
# SLOTSERVE_REGISTRATION_OPEN=true

# Signs session cookies. Generate one with: openssl rand -hex 32
SLOTSERVE_SECRET_KEY=change-me

# Default llama-server arguments for newly added models (editable per model in the UI).
SLOTSERVE_DEFAULT_LLAMA_ARGS=-ngl 99 -c 8192

# Booking rules.
SLOTSERVE_SLOT_MINUTES=30
SLOTSERVE_MAX_RESERVATION_HOURS=8
SLOTSERVE_MAX_ADVANCE_DAYS=30

# Disk read speed (MB/s) used to estimate load time before a model has been loaded once.
SLOTSERVE_DISK_READ_MBPS=150

# Give up loading a model after this many seconds.
SLOTSERVE_LOAD_TIMEOUT_SECONDS=1800

# Set to true when serving over HTTPS (behind a reverse proxy).
SLOTSERVE_COOKIE_SECURE=false

# Optional integrations (can also be set in Admin -> System settings)
# SLOTSERVE_TIMEZONE=Europe/Berlin
# SLOTSERVE_PUBLIC_URL=http://gpu-server:8000
# SLOTSERVE_TELEGRAM_BOT_TOKEN=
# SLOTSERVE_TELEGRAM_PROXY=
# SLOTSERVE_HF_ENDPOINT=https://huggingface.co
# SLOTSERVE_METRICS_TOKEN=

# Housekeeping
# SLOTSERVE_DRAIN_SECONDS=30
# SLOTSERVE_USAGE_RETENTION_DAYS=365
# SLOTSERVE_AUDIT_RETENTION_DAYS=730
# SLOTSERVE_BACKUP_KEEP=7

# Start loading a booked model at least this many minutes before it starts
# SLOTSERVE_PRELOAD_MIN_MINUTES=3

# Bookings that need an admin's approval: off | long | all
# SLOTSERVE_APPROVAL_MODE=off
# SLOTSERVE_APPROVAL_HOURS=4
